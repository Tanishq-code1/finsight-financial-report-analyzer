# =====================================================================
# Financial Report Analyzer — Environment Configuration Template
# Copy this file to .env and provide your actual API key.
# NEVER commit .env to source control.
# =====================================================================

# Google Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Document ingestion limits
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=250

# Chunking & Retrieval parameters
CHUNK_SIZE_TOKENS=850
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=5
MIN_EVIDENCE_THRESHOLD=0.35

# Embedding rate limits & pacing (aligns with Google AI Studio tier limits)
EMBEDDING_TPM_LIMIT=30000
EMBEDDING_RPM_LIMIT=60
EMBEDDING_SAFETY_MARGIN=0.80
EMBEDDING_MAX_RETRIES=5
EMBEDDING_INITIAL_BACKOFF_SEC=2.0
EMBEDDING_MAX_BACKOFF_SEC=60.0
EMBEDDING_BATCH_SIZE=1

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
